{
  "changelog": "CHANGELOG.md",
  "heading_format": "## [{version}] - {date}",
  "group_by_type": true,
  "tag_format": "v{version}",
  "versioning": {
    "preset": "semver",
    "format": "{major}.{minor}.{patch}",
    "bump_rules": {
      "breaking": "major",
      "added": "minor",
      "default": "patch"
    },
    "zero_major": true
  },
  "version_files": [
    "package.json",
    "src-tauri/Cargo.toml",
    "src-tauri/tauri.conf.json"
  ],
  "whats_new_path": null,
  "skip_types": [
    "build",
    "chore",
    "ci",
    "docs",
    "refactor",
    "style",
    "test",
    "tests"
  ],
  "ignore": [
    "^Merge (pull request|branch|remote-tracking branch) ",
    "^chore\\(release\\)",
    "^Release v?\\d+\\.\\d+",
    "^v?\\d+(\\.\\d+)+\\S*$",
    "\\[(skip|no) changelog\\]"
  ],
  "normalize": [],
  "baseline": "0979bf9f22a790ae744e2f3db0a4e944b2879140"
}
